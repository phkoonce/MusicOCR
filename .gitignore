# Python
.venv/
__pycache__/
*.pyc
*.egg-info/
.pytest_cache/

# Pipeline inputs & outputs — never committed
/input/*
!/input/.gitkeep
/output/*
!/output/.gitkeep
/samples/*
!/samples/.gitkeep

# Stray OMR / score artifacts if run outside the managed dirs
*.omr
*.mxl
*.mscz
*.mid

# macOS / editors
.DS_Store
.idea/
.vscode/

# Experiment sweeps (scripts/experiment.py)
/experiments/

# omr-eval: derived scan pages / OMR output — same "never committed" policy as
# /input, /output (copyrighted source material), keep only setup.sh + README.md
/omr-eval/pages/
/omr-eval/*/*.musicxml
/omr-eval/*/*.png

# omr-eval: per-piece alignment specs (hand-written, piece-specific) -- local only
/omr-eval/specs/

# omr-eval: Copisteria clone + downloaded model weights (setup.sh recreates)
/omr-eval/copisteria/
/omr-eval/legato2/

# Local batch specs (personal paths, piece-specific); the generic example is
# scripts/batch.example.toml
/batches/

# Auto-generated batch progress docs (musicocr.batch) -- local state, not source
/docs/*-progress.md

# Claude Code agent worktrees
/.claude/
